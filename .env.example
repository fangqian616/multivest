# ═══════════════════════════════════════════════════════════
#  智能多维投资系统 · 环境变量示例
#
#  用法：复制本文件为 .env 并填入真实值
#        .env 已被 .gitignore 忽略，不会进入版本库
#
#  也可以改用 ~/.dsh/.credentials.yaml，或直接设同名环境变量。
# ═══════════════════════════════════════════════════════════

# ── 必填：大模型后端（OpenAI 兼容接口）─────────────────────
DEEPSEEK_API_KEY=sk-你的密钥

# ── 可选：覆盖默认后端与模型 ────────────────────────────────
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── 可选：每晚研判 ──────────────────────────────────────────
# MULTIVEST_NIGHTLY_AT=20:30          # 触发时间（交易日一次）
# MULTIVEST_NIGHTLY_ENABLED=1         # 设为 0 关闭定时任务

# ── 可选：数据落盘位置 ──────────────────────────────────────
# 默认：exe 同级的「智能多维数据/」（源码运行时为 backend/）
# MULTIVEST_DATA_DIR=D:\我的投资数据

# ── 可选：TLS 证书（仅内网自签证书时需要）──────────────────
# 本机若有 TLS 拦截导致 requests 报
#   SSLCertVerificationError: self-signed certificate in certificate chain
# 正确做法是 pip install truststore（用系统证书库）。
# 只有在确实无法装 truststore 时才用下面这个开关 —— 它会关闭证书校验，
# 公网环境下会把 API Key 暴露给中间人，启动时会打警告。
# MULTIVEST_INSECURE_SSL=1
